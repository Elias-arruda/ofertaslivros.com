{
  "name": "ofertaslivros",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Só o POST do "Pedir um livro" roda o Worker; o resto sai direto dos assets (sem custo de requisição).
    "run_worker_first": ["/pedido"]
  },
  // E-mail pela Email Routing do .com.br. O destino (verificado no painel) fica no segredo
  // PEDIDOS_PARA do Worker, fora do repo: Worker > Settings > Variables and Secrets.
  "send_email": [{ "name": "PEDIDOS" }],
  // Anti-spam: 5 pedidos por minuto por IP (a chave não é guardada).
  "ratelimits": [{ "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
