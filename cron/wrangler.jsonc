{
  // Agendador: a cada 30 min dispara o workflow "pipeline" (coleta) e, no minuto 5 das horas pares (UTC, a cada 2h),
  // o "curator" (suggest), que acrescenta candidatos ao PR do dia.
  // Às 03:15 UTC grava no D1 o rollup do analytics do dia anterior (rollup.js).
  // O cron do GitHub Actions atrasa horas em horário de pico; o Cron Trigger da Cloudflare não.
  "name": "ofertaslivros-cron",
  "main": "index.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/30 * * * *", "5 */2 * * *", "15 3 * * *"]
  },
  // D1 do analytics (daily_rollup; depois sales). A tabela é criada pelo próprio rollup.
  "d1_databases": [{ "binding": "ANALYTICS", "database_name": "ofertaslivros-analytics", "database_id": "aa8a7b0d-e44f-4c1c-8c11-b6e204460e32" }]
  // Segredo GH_DISPATCH_TOKEN (fine-grained PAT, só este repo, Actions: read and write):
  // cadastrar uma vez no painel (Worker > Settings > Variables and Secrets) ou com `wrangler secret put`.
  // Segredo CF_ANALYTICS_TOKEN (token só de leitura: Account Analytics Read + Zone Analytics Read do .com.br), mesmo lugar.
}
